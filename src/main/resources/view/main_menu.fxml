                                                <ImageView fitHeight="46.0" fitWidth="68.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                                                    <cursor>
                                                        <Cursor fx:constant="DEFAULT" />
                                                    </cursor>
                                                    <image>
                                                        <Image url="@../image/menu/icons/icon_dashboard(white).png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                        <Button contentDisplay="TOP" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="66.0" prefWidth="198.0" styleClass="left_menu-button" stylesheets="@../css/menu.css" text="PROJECT">
                                            <graphic>
                                                <ImageView fitHeight="63.0" fitWidth="70.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../image/menu/icons/icon_project.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                        <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="66.0" prefWidth="198.0" styleClass="left_menu-button" stylesheets="@../css/menu.css" text=" STATISTICS">
                                            <graphic>
                                                <ImageView fitHeight="59.0" fitWidth="68.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../image/menu/icons/icon_statics.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                        <Button minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="66.0" prefWidth="198.0" styleClass="left_menu-button" stylesheets="@../css/menu.css" text=" SETTINGS">
