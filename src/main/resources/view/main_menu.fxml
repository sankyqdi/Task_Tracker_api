                                        <Image url="@../image/menu/icons/icon_eye.png" />
                                    </image>
                                    <effect>
                                        <Blend mode="RED" />
                                    </effect>
                                </ImageView>
                            </children>
                        </StackPane>
                        <StackPane fx:id="exitButton" maxHeight="70.0" maxWidth="220.0" prefHeight="60.0" prefWidth="220.0" styleClass="main_menu-card" stylesheets="@../css/menu.css">
                            <children>
                                <ImageView fx:id="exitFrame" fitHeight="60.0" fitWidth="220.0" mouseTransparent="true" pickOnBounds="true">
                                    <image>
                                        <Image url="@../image/menu/frame_menu.png" />
                                    </image>
                                </ImageView>
                                <HBox alignment="CENTER_RIGHT" mouseTransparent="true">
                                    <children>
                                        <VBox alignment="CENTER_LEFT" prefWidth="140.0">
                                            <children>
                                                <Label styleClass="main_menu-card-title" stylesheets="@../css/menu.css" text="Exit" textFill="#eb0707" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <ImageView fitHeight="46.0" fitWidth="68.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER_LEFT">
                                    <image>
                                        <Image url="@../image/menu/icons/icon_exit.png" />
                                    </image>
                                    <effect>
                                        <Blend mode="RED" />
                                    </effect>
                                </ImageView>
                            </children>
                        </StackPane>
                    </children>
                </VBox>
            </center>
            <right>
                <VBox prefHeight="740.0" prefWidth="227.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="labelTime" alignment="BOTTOM_RIGHT" prefHeight="42.0" prefWidth="216.0" styleClass="cyber-clock-time" stylesheets="@../css/time.css" />
                  <Label fx:id="labelDate" alignment="TOP_RIGHT" prefHeight="42.0" prefWidth="203.0" styleClass="cyber-clock-date" stylesheets="@../css/time.css" />
               </children></VBox>
            </right>
