                                    </image>
                                    <effect>
                                        <Blend mode="RED" />
                                    </effect>
                                </ImageView>
                            </children>
                        </StackPane>
                        <StackPane fx:id="showAllTasksButton" maxHeight="70.0" maxWidth="220.0" onMouseClicked="#handleShowTasksClick" prefHeight="60.0" prefWidth="220.0" styleClass="main_menu-card" stylesheets="@../css/menu.css">
