                <VBox prefHeight="740.0" prefWidth="227.0" BorderPane.alignment="TOP_CENTER">
                    <children>
                        <ImageView fitHeight="132.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../image/menu/emblem.png" />
                            </image>
                        </ImageView>
                        <StackPane maxWidth="1.7976931348623157E308" stylesheets="@../css/menu.css" VBox.vgrow="ALWAYS">
                            <children>
                                <ImageView accessibleRole="MENU_ITEM" fitHeight="439.0" fitWidth="202.0" opacity="0.59" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_LEFT">
                                    <image>
                                        <Image url="@../image/menu/left_menu.png" />
                                    </image>
                                </ImageView>
                                <VBox maxWidth="-Infinity" prefWidth="228.0" spacing="10.0" StackPane.alignment="TOP_RIGHT">
                                    <children>
                                        <Button contentDisplay="TOP" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="66.0" prefWidth="198.0" styleClass="left_menu-button" stylesheets="@../css/menu.css" text="DACHBOARD">
