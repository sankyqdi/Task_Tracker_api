                                                        <Font name="SimSun-ExtG" size="12.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                                <ImageView fitHeight="46.0" fitWidth="73.0" mouseTransparent="true" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true" styleClass="main_menu-card-icon" StackPane.alignment="CENTER_LEFT">
