                                <ImageView fx:id="showTasksFrame" fitHeight="60.0" fitWidth="216.0" mouseTransparent="true" nodeOrientation="INHERIT" pickOnBounds="true">
                                    <image>
                                        <Image url="@../image/menu/frame_menu.png" />
                                    </image>
                                </ImageView>
                                <HBox alignment="CENTER_RIGHT" mouseTransparent="true">
                                    <children>
                                        <VBox prefWidth="140.0">
                                            <children>
                                                <Label styleClass="main_menu-card-title" stylesheets="@../css/menu.css" text="Show " textFill="#eb0707" />
