                                                <ImageView fitHeight="61.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../image/menu/icons/icon_settings.png" />
                                                    </image>
                                                </ImageView>
                                            </graphic>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                  <ImageView fitHeight="99.0" fitWidth="97.0" onMouseClicked="#handleBarsuckClick" pickOnBounds="true" preserveRatio="true">
